rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.avatar is string && data.avatar.size() <= 500
        && data.targetExam is string && data.targetExam.size() <= 100
        && (!('targetRole' in data) || (data.targetRole is string && data.targetRole.size() <= 100))
        && data.dailyGoalQuestions is number && data.dailyGoalQuestions >= 1 && data.dailyGoalQuestions <= 1000
        && data.experienceLevel is string && data.experienceLevel in ['iniciante', 'intermediario', 'avancado', 'faixa_preta']
        && data.isCloudSyncEnabled is bool
        && data.provider is string && data.provider in ['google', 'local'];
    }

    function isValidUserSyncData(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.lastSyncedAt is string && data.lastSyncedAt.size() <= 50;
    }

    // Global Safety Net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Deny public or bulk user listing

      allow create: if isOwner(userId) 
        && isValidId(userId) 
        && isValidUserProfile(incoming()) 
        && incoming().userId == request.auth.uid;

      allow update: if isOwner(userId) 
        && isValidId(userId) 
        && isValidUserProfile(incoming()) 
        && incoming().userId == existing().userId;

      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection for synchronizing study progress
      match /sync/{syncId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(syncId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) 
          && isValidId(userId) 
          && isValidId(syncId) 
          && isValidUserSyncData(incoming()) 
          && incoming().userId == request.auth.uid;

        allow update: if isOwner(userId) 
          && isValidId(userId) 
          && isValidId(syncId) 
          && isValidUserSyncData(incoming()) 
          && incoming().userId == existing().userId;

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(syncId);
      }
    }
  }
}
